NEXT_PUBLIC_MEDPLUM_BASE_URL=http://localhost:8103/
SESSION_SECRET=replace-me-32-bytes-min

# Service-account creds for privileged server actions (invite endpoint
# requires ProjectMembership.admin=true on the requesting principal).
# Use a dedicated bot user in production, never a human admin.
MEDPLUM_ADMIN_EMAIL=admin@vendo.local
MEDPLUM_ADMIN_PASSWORD=replace-me

# Phase 1.9 — email layer.
#
# Default (no SMTP_HOST): emails are rendered + logged but not sent
# (StubTransport). Useful for non-email work; rendered subject + preview
# show up in `pnpm dev` console as `email_stub_send`.
#
# Local dev (with MailHog from infra/compose/docker-compose.yml):
SMTP_HOST=localhost
SMTP_PORT=1025
# MailHog accepts unauthenticated mail; leave SMTP_USER / SMTP_PASSWORD blank.
# Open http://localhost:8025 in a browser to see every email rendered.
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Vendo Demo Clinic

# Production: point at Postmark / SES / Mailgun / Resend SMTP endpoint.
# Example (Postmark):
#   SMTP_HOST=smtp.postmarkapp.com
#   SMTP_PORT=587
#   SMTP_USER=<server token>
#   SMTP_PASSWORD=<server token>
#   SMTP_FROM_ADDRESS=referrals@portal.example.com  (must be verified in Postmark)

# Phase 1.10 — clinic branding overrides.
# NEXT_PUBLIC_BRAND_* vars bake into the client bundle at build time (not
# secrets). Defaults live in apps/portal/src/lib/branding.ts.
# NEXT_PUBLIC_BRAND_NAME=Acme Imaging
# NEXT_PUBLIC_BRAND_SHORT_NAME=Acme
# NEXT_PUBLIC_BRAND_INITIALS=AI
# NEXT_PUBLIC_BRAND_TAGLINE=Imaging & Diagnostics
# NEXT_PUBLIC_BRAND_PHONE=(555) 010-0100
# NEXT_PUBLIC_BRAND_PHONE_TEL=5550100100
# NEXT_PUBLIC_BRAND_ADDRESS=100 Example Street, Springfield, IL 62701
# NEXT_PUBLIC_BRAND_HOURS=M–F 9am–7pm · Sat–Sun closed
# NEXT_PUBLIC_BRAND_PORTAL_URL=https://portal.example.com
# NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=info@example.com
# NEXT_PUBLIC_BRAND_RECORDS_EMAIL=records@example.com
